# ==============================================================================
# QUADROTOR DRONE MODEL (DJI Mavic 2 Pro with Sensor Suite)
# ==============================================================================
Mavic2Pro {
  translation 0 0 0.15
  rotation 0 0 1 0
  name "Mavic 2 PRO"
  controller "<extern>"
  cameraSlot [
    Camera {
      name "camera"
      width 400
      height 240
      fieldOfView 1.05
    }
    Camera {
      name "thermal_camera"
      width 400
      height 240
      fieldOfView 1.05
    }
    Accelerometer {
      name "accelerometer"
    }
  ]
}
