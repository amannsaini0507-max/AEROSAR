# Copy to `.env.local` (git-ignored) and edit.
#
# Leave VITE_WS_URL empty to run the dashboard against the built-in
# in-browser simulator (no backend needed).
#
# Member 4's FastAPI backend (master doc §6.4) exposes:
#   WebSocket  /ws/live
#   REST       /api/missions/{id}/history
VITE_WS_URL=
VITE_API_BASE=
